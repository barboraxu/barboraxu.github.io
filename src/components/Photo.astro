---
import photos from "../data/photos.json";
const {
  slug,
  alt,
  sizes = "(max-width: 760px) 100vw, 50vw",
  loading = "lazy",
  ...attributes
} = Astro.props;
const photo = photos.find((p) => p.slug === slug);
if (!photo) throw new Error(`Unknown photograph: ${slug}`);
const root = `${import.meta.env.BASE_URL}images/${slug}`;
---

<img
  src={`${root}.webp`}
  srcset={`${root}-480.webp 480w, ${root}-800.webp 800w, ${root}.webp 1400w`}
  sizes={sizes}
  width={photo.width}
  height={photo.height}
  alt={alt ?? photo.alt}
  loading={loading}
  decoding="async"
  {...attributes}
/>
