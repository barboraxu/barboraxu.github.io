---
const reelUrl = 'https://www.instagram.com/reel/DeRLCZGsbDm/';
---
<section class="caisa-teaser" aria-labelledby="caisa-teaser-heading">
  <div class="teaser-copy">
    <p class="eyebrow">A glimpse of the concert</p>
    <h3 id="caisa-teaser-heading">Step into the forest.<br /><em>Before the music begins.</em></h3>
    <p>Watch the Caisa concert teaser from Barbora Xu.</p>
    <a class="text-link" href={reelUrl} target="_blank" rel="noopener noreferrer">Watch on Instagram <span aria-hidden="true">↗</span></a>
  </div>
  <div class="teaser-player">
    <blockquote class="instagram-media" data-instgrm-permalink={reelUrl} data-instgrm-version="14">
      <a href={reelUrl} target="_blank" rel="noopener noreferrer">Watch the Caisa concert teaser on Instagram — Barbora Xu (@barboraxu.music)</a>
    </blockquote>
  </div>
</section>
<script is:inline async src="https://www.instagram.com/embed.js"></script>
