---
const reelUrl = "https://www.instagram.com/reel/DeRLCZGsbDm/";
---

<section class="caisa-teaser" aria-labelledby="caisa-teaser-heading">
  <div class="teaser-copy">
    <p class="eyebrow">A glimpse of the concert</p>
    <h3 id="caisa-teaser-heading">
      Step into the forest.
      <br />
      <em>Before the music begins.</em>
    </h3>
    <p>Watch the Caisa concert teaser from Barbora Xu.</p>
    <a
      class="text-link"
      href={reelUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      Watch on Instagram <span aria-hidden="true">↗</span>
    </a>
  </div>
  <div
    class="teaser-player"
    data-concert-teaser
    data-video-src={`${import.meta.env.BASE_URL}videos/caisa-teaser.mp4`}
  >
    <button type="button" class="teaser-load" aria-label="Play concert teaser">
      <img
        src={`${import.meta.env.BASE_URL}images/caisa-teaser.webp`}
        width="720"
        height="1280"
        loading="lazy"
        decoding="async"
        alt="Preview of the Caisa concert teaser"
      />
      <span class="teaser-play-label">
        Play concert teaser <span aria-hidden="true">▷</span>
      </span>
    </button>
  </div>
</section>
<script>
  const player = document.querySelector<HTMLElement>("[data-concert-teaser]");
  const button = player?.querySelector<HTMLButtonElement>(".teaser-load");
  button?.addEventListener("click", () => {
    const video = document.createElement("video");
    video.src = player!.dataset.videoSrc!;
    video.poster = button.querySelector("img")!.src;
    video.controls = true;
    video.playsInline = true;
    video.width = 720;
    video.height = 1280;
    video.setAttribute("aria-label", "Caisa concert teaser by Barbora Xu");
    video.tabIndex = 0;
    button.replaceWith(video);
    video.focus({ preventScroll: true });
    // Start inside the user's click gesture, with native controls as a fallback.
    video.play().catch(() => {
      /* The visitor can retry using the video controls. */
    });
  });
</script>
