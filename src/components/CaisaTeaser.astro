---
const reelUrl = "https://www.instagram.com/reel/DeRLCZGsbDm/";
---

<section class="caisa-teaser" aria-labelledby="caisa-teaser-heading">
  <div class="teaser-copy">
    <p class="eyebrow">A glimpse of the concert</p>
    <h3 id="caisa-teaser-heading">
      Step into the forest.
      <br />
      <em>Before the music begins.</em>
    </h3>
    <p>Watch the Caisa concert teaser from Barbora Xu.</p>
    <a
      class="text-link"
      href={reelUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      Watch on Instagram <span aria-hidden="true">↗</span>
    </a>
  </div>
  <div class="teaser-player" data-instagram-teaser>
    <button
      type="button"
      class="teaser-load"
      aria-label="Play concert teaser on Instagram"
    >
      <img
        src={`${import.meta.env.BASE_URL}images/caisa-teaser.webp`}
        width="720"
        height="1280"
        loading="lazy"
        decoding="async"
        alt="Preview of the Caisa concert teaser"
      />
      <span class="teaser-play-label">
        Play concert teaser <span aria-hidden="true">▷</span>
      </span>
    </button>
  </div>
</section>
<script>
  const player = document.querySelector("[data-instagram-teaser]");
  const button = player?.querySelector<HTMLButtonElement>(".teaser-load");
  button?.addEventListener("click", () => {
    const frame = document.createElement("iframe");
    frame.src = "https://www.instagram.com/reel/DeRLCZGsbDm/embed/";
    frame.title = "Caisa concert teaser by Barbora Xu on Instagram";
    frame.allow = "autoplay; encrypted-media; fullscreen; picture-in-picture";
    frame.allowFullscreen = true;
    button.replaceWith(frame);
  });
</script>
