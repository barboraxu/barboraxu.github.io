---
import { upcoming } from '../utils/concerts';
import CaisaTeaser from './CaisaTeaser.astro';
const { homepage = false } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<section class:list={['upcoming-concerts', { 'section': homepage, 'invitation-section': homepage && upcoming.length > 0 }]} aria-labelledby="upcoming-heading">
  <div class="concert-heading"><p class="eyebrow">{homepage && upcoming.length ? 'You’re invited' : 'Upcoming performances'}</p><h2 id="upcoming-heading">{homepage && upcoming.length ? 'Let the forest come to you.' : 'Upcoming concerts.'}</h2>{homepage && upcoming.length > 0 && <p class="invitation-intro">Join Barbora Xu for an immersive concert. Find your date below and come share a moment of music.</p>}</div>
  {homepage && <CaisaTeaser />}
  {upcoming.length ? <div class="concert-cards">{upcoming.map(event => <article class="concert-card">
    <div class="invitation-date"><span class="date-number" aria-hidden="true">{event.date.slice(8)}</span><p class="concert-date"><span class="invitation-label">Your invitation</span><time datetime={event.date}>{event.dateLabel}</time></p></div>
    <h3>{event.title}</h3>
    <p class="concert-venue">{event.location}</p>
    {event.programme && <ul class="concert-programme">{event.programme.map(item => <li><strong>{item.time}</strong><span>{item.description}</span></li>)}</ul>}
    {event.note && <p class="concert-note">{event.note}</p>}
    <div class="concert-actions">{event.ticketUrl && <a class="button ticket-button" href={event.ticketUrl} aria-label={`Buy tickets for ${event.dateLabel}`}>Join us · Book tickets <span aria-hidden="true">↗</span></a>}{event.url && <a href={event.url}>Event details ↗</a>}{event.facebookUrl && <a href={event.facebookUrl}>Facebook event ↗</a>}</div>
  </article>)}</div> : <div class="empty"><p>New dates will be announced here.</p><a href={`${base}contact/`}>Get in touch about a performance ↗</a></div>}
  {homepage && <a class="text-link" href={`${base}concert/`}>All concerts & archive <span aria-hidden="true">↗</span></a>}
</section>
