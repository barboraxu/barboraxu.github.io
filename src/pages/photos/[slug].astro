---
import Base from '../../layouts/Base.astro';
import photos from '../../data/photos.json';
export function getStaticPaths(){return photos.map(photo=>({params:{slug:photo.slug},props:{photo}}));}
const {photo}=Astro.props;
const base=import.meta.env.BASE_URL;
---
<Base title="Photograph"><div class="content photo-detail"><p><a href={`${base}gallery/`}>← Back to gallery</a></p><h1 class="sr-only">{photo.alt}</h1><img src={`${base}images/${photo.slug}.jpg`} alt={photo.alt} />{photo.credit && <p class="credit">Photography · {photo.credit}</p>}<a class="text-link" href={`${base}images/${photo.slug}.jpg`}>View original image ↗</a></div></Base>
