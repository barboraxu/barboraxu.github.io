---
import Base from "../../layouts/Base.astro";
import photos from "../../data/photos.json";
import Photo from "../../components/Photo.astro";
export function getStaticPaths() {
  return photos.map((photo) => ({
    params: { slug: photo.slug },
    props: { photo },
  }));
}
const { photo } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<Base
  title={photo.alt}
  description={`${photo.alt}${photo.credit ? ` · Photography by ${photo.credit}` : ""}. View the photograph and access the original image.`}
>
  <div class="content photo-detail">
    <p>
      <a href={`${base}gallery/`}>← Back to gallery</a>
    </p>
    <h1 class="sr-only">{photo.alt}</h1>
    <Photo
      slug={photo.slug}
      sizes="(max-width: 760px) 86vw, 65vw"
      loading="eager"
    />
    {photo.credit && <p class="credit">Photography · {photo.credit}</p>}
    <a class="text-link" href={`${base}images/${photo.slug}.jpg`}>
      View original image ↗
    </a>
  </div>
</Base>
