---
import Base from "../layouts/Base.astro";
import Photo from "../components/Photo.astro";
import site from "../data/site.json";
const base = import.meta.env.BASE_URL;
---

<Base title="About & EPK">
  <header class="page-head">
    <p class="eyebrow">About the artist · Electronic press kit</p>
    <h1>
      Barbora <em>Xu.</em>
    </h1>
    <p>
      Singer, composer and multi-instrumentalist. Music inspired by poetry, the
      natural world and the meeting of traditions.
    </p>
  </header>
  <section class="section split">
    <figure>
      <Photo
        class="portrait"
        slug="jussi-1"
        alt="Portrait of Barbora Xu in the forest"
      />
      <figcaption class="credit">Photography · Jussi Vierimaa</figcaption>
    </figure>
    <div class="prose">
      {site.biography.map((p) => (
        <p>{p}</p>
      ))}
      <a class="text-link" href={`${base}contact/`}>
        Booking & enquiries ↗
      </a>
    </div>
  </section>
  <section class="quote">
    <p class="eyebrow">Press</p>
    <blockquote>“A work of luminous artistry”</blockquote>
    <a href="https://www.songlines.co.uk/review/olin-ennen">
      Charlie Cawood · Songlines ★★★★ ↗
    </a>
  </section>
  <section class="section split">
    <div>
      <p class="eyebrow">For presenters & press</p>
      <h2>Press materials.</h2>
    </div>
    <div>
      <p>
        Download high-resolution publicity photographs, explore the gallery, and
        hear Barbora’s music. Please include the photographer’s credit when
        using images.
      </p>
      <a class="text-link" href={site.pressPhotos}>
        High-resolution press photographs ↗
      </a>
      <a class="text-link" href={`${base}gallery/`}>
        Photo gallery ↗
      </a>
      <a class="text-link" href={`${base}music/`}>
        Music & videos ↗
      </a>
    </div>
  </section>
</Base>
