---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
const base=import.meta.env.BASE_URL;
---
<Base home>
<section class="hero">
  <div class="hero-copy"><p class="eyebrow">Voice · Kantele · Guzheng</p><h1>Between forests,<br />poetry <em>& strings.</em></h1><p class="intro">{site.intro}</p><a class="button light" href={`${base}music/`}>Explore the music <span>↗</span></a><p class="hero-note">BARBORA XU · SINGER & COMPOSER</p></div>
  <figure class="hero-photo"><img src={`${base}images/album-cover-pic.webp`} alt="Barbora Xu holding her guzheng in the forest" fetchpriority="high" width="1200" height="1800" /><figcaption>Photography · Jussi Vierimaa</figcaption></figure>
</section>
<section class="quote"><p class="eyebrow">In the words of Songlines</p><blockquote>“A work of luminous artistry”</blockquote><a href="https://www.songlines.co.uk/review/olin-ennen">Charlie Cawood · Songlines ★★★★ ↗</a></section>
<section class="section split"><div><p class="eyebrow">The artist</p><h2>Rooted in nature.<br /><em>Open to the world.</em></h2></div><div class="prose"><p>{site.biography[0]}</p><p>{site.biography[1]}</p><a class="text-link" href={`${base}epk/`}>Meet Barbora <span>↗</span></a></div></section>
<section class="feature section"><img src={`${base}images/holding-guzheng.webp`} alt="Barbora Xu with her guzheng among the trees" loading="lazy" width="1000" height="1500" /><div><p class="eyebrow">Music & moving images</p><h2>A moment<br /><em>to listen.</em></h2><p>Discover Olin Ennen, The Garden of Otava and live performances.</p><a class="button" href={`${base}music/`}>Listen & watch <span>↗</span></a><p class="credit">Photography · Jussi Vierimaa</p></div></section>
<section class="project-band section"><p class="eyebrow">Old Forest Echoes</p><h2>Music for the forests.<br /><em>And their future.</em></h2><p>Art, concerts and encounters in Finland’s old growth forests, raising awareness and funds for their protection.</p><a class="button light" href={`${base}oldforestechoes/`}>Discover the project <span>↗</span></a></section>
<section class="section split"><div><p class="eyebrow">On stage</p><h2>Meet in the music.</h2></div><div class="prose"><p>Concerts, forest performances and collaborations.</p><a class="text-link" href={`${base}concert/`}>Explore the concert calendar <span>↗</span></a></div></section>
</Base>
