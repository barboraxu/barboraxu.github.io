---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
---
<Base title="Contact"><header class="page-head"><p class="eyebrow">Bookings · Collaborations · Conversations</p><h1>Get in <em>touch.</em></h1><p>For performances, collaborations and press enquiries.</p></header><section class="content contact-grid"><div><p class="eyebrow">Artist</p><h2>{site.artistName}</h2><p><a href={`mailto:${site.email}`}>{site.email}</a></p>{site.phones.map(phone=><p><a href={`tel:${phone.replaceAll(' ','')}`}>{phone}</a></p>)}</div><div><p class="eyebrow">Label</p><h2>Nordic Notes</h2><p><a href="https://www.nordic-notes.de/">nordic-notes.de ↗</a><br /><a href="mailto:info@nordic-notes.de">info@nordic-notes.de</a></p><p><a href="tel:+499101904474">+49 9101 904474</a><br /><a href="tel:+491702468565">+49 170 2468565</a></p></div></section></Base>
