---
import Base from '../layouts/Base.astro';
import project from '../data/old-forest-echoes.json';
const base=import.meta.env.BASE_URL;
---
<Base title="Old Forest Echoes"><header class="page-head"><p class="eyebrow">Music · Art · Forest protection</p><h1>Old Forest <em>Echoes.</em></h1><p>Ikimetsän kaiku — fall in love with old growth forests through music and art composed and performed there.</p></header><section class="section split"><img class="portrait" src={`${base}images/nuku-nuku-cover.webp`} alt="Barbora Xu with her guzheng in the forest" loading="lazy" /><div class="prose">{project.summary.map(paragraph => <p>{paragraph}</p>)}<p>Find the full story, latest events and ways to support the forests at <a href={project.source}>oldforestechoes.com</a>.</p><a class="button" href={project.source}>Visit Old Forest Echoes ↗</a><a class="text-link" href={`${base}concert/`}>Concerts & tickets ↗</a><p class="credit">Photography · Jussi Vierimaa</p></div></section></Base>
