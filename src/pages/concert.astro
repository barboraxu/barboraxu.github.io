---
import Base from '../layouts/Base.astro';
import UpcomingConcerts from '../components/UpcomingConcerts.astro';
import { past } from '../utils/concerts';
const years=[...new Set(past.map(c=>c.date.slice(0,4)))];
---
<Base title="Concerts">
  <header class="page-head"><p class="eyebrow">Concerts & encounters</p><h1>Come <em>listen.</em></h1><p>From concert halls to forest clearings. Performances, collaborations and residencies.</p></header>
  <div class="content"><UpcomingConcerts /></div>
  <section class="content concert-archive"><p class="eyebrow">Past performances</p><h2>Concert archive.</h2>
    {years.map(year=><section><h3>{year}</h3><ul class="event-list">{past.filter(c=>c.date.startsWith(year)).map(c=><li><time datetime={c.date}>{c.dateLabel}</time><div><h3>{c.title}</h3>{c.location && <p>{c.location}</p>}{c.url && <a href={c.url}>Event details ↗</a>}</div></li>)}</ul></section>)}
  </section>
</Base>
